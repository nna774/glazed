    # pkg:gem/httpx#lib/httpx/adapters/webmock.rb:15
    def build_webmock_request_signature(request); end

    # pkg:gem/httpx#lib/httpx/adapters/webmock.rb:28
    def build_webmock_response(_request, response); end
  end
end

