module HTTPX::ResponsePatternMatchExtensions
  # pkg:gem/httpx#lib/httpx/pmatch_extensions.rb:5
  def deconstruct; end

  # pkg:gem/httpx#lib/httpx/pmatch_extensions.rb:9
  def deconstruct_keys(_keys); end
end

# session may be overridden by certain adapters.
#
# pkg:gem/httpx#lib/httpx/session.rb:604
HTTPX::S = HTTPX::Session

