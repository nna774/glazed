end

# The exception class for HTTP responses with 4xx or 5xx status.
#
# pkg:gem/httpx#lib/httpx/errors.rb:104
class HTTPX::HTTPError < ::HTTPX::Error
  # Creates the instance and assigns the HTTPX::Response +response+.
