# Implementation of the HTTP Request body as a delegator which iterates (responds to +each+) payload chunks.
#
# pkg:gem/httpx#lib/httpx/request/body.rb:5
class HTTPX::Request::Body < ::SimpleDelegator
  # inits the instance with the request +headers+, +options+ and +params+, which contain the payload definition.
  # it wraps the given body with the appropriate encoder on initialization.
  #
  #   ..., json: { foo: "bar" }) #=> json encoder
  #   ..., form: { foo: "bar" }) #=> form urlencoded encoder
  #   ..., form: { foo: Pathname.open("path/to/file") }) #=> multipart urlencoded encoder
  #   ..., form: { foo: File.open("path/to/file") }) #=> multipart urlencoded encoder
  #   ..., form: { body: "bla") }) #=> raw data encoder
  #
  # pkg:gem/httpx#lib/httpx/request/body.rb:31
  def initialize(h, options, **params); end

  # returns the +@body+ payload size in bytes.
  #
  # pkg:gem/httpx#lib/httpx/request/body.rb:90
  def bytesize; end

  # sets the chunked transfer encoding header.
  #
  # pkg:gem/httpx#lib/httpx/request/body.rb:116
  def chunk!; end

  # returns whether the chunked transfer encoding header is set.
  #
  # pkg:gem/httpx#lib/httpx/request/body.rb:111
  def chunked?; end

  # pkg:gem/httpx#lib/httpx/request/body.rb:70
  def close; end

  # consumes and yields the request payload in chunks.
  #
  # pkg:gem/httpx#lib/httpx/request/body.rb:52
  def each(&block); end

  # return +true+ if the +body+ has been fully drained (or does nnot exist).
  #
  # pkg:gem/httpx#lib/httpx/request/body.rb:82
  def empty?; end

  # simplecov:disable
  #
  # pkg:gem/httpx#lib/httpx/request/body.rb:121
  def inspect; end

  # pkg:gem/httpx#lib/httpx/request/body.rb:21
  def options; end

  # pkg:gem/httpx#lib/httpx/request/body.rb:21
  def options=(_arg0); end

  # if the +@body+ is rewindable, it rewinnds it.
  #
  # pkg:gem/httpx#lib/httpx/request/body.rb:75
  def rewind; end

  # sets the body to yield using chunked trannsfer encoding format.
  #
  # pkg:gem/httpx#lib/httpx/request/body.rb:97
  def stream(body); end

  # returns whether the body yields infinitely.
  #
  # pkg:gem/httpx#lib/httpx/request/body.rb:104
  def unbounded_body?; end

  class << self
    # pkg:gem/httpx#lib/httpx/request/body.rb:128
    def initialize_body(params); end

    # returns the +body+ wrapped with the correct deflater accordinng to the given +encodisng+.
    #
    # pkg:gem/httpx#lib/httpx/request/body.rb:147
    def initialize_deflater_body(body, encoding); end

    # pkg:gem/httpx#lib/httpx/request/body.rb:7
    def new(h, options, body: T.unsafe(nil), **params); end
  end
end

