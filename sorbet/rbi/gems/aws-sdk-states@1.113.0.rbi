  #
  #   * white space
  #
  #   * brackets `< > { } [ ]`
  #
  #   * wildcard characters `? *`
  #
  #   * special characters `` " # % \ ^ | ~ ` $ & , ; : / ``
  #
  #   * control characters (`U+0000-001F`, `U+007F-009F`, `U+FFFE-FFFF`)
  #
  #   * surrogates (`U+D800-DFFF`)
  #
  #   * invalid characters (` U+10FFFF`)
